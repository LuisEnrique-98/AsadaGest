@page "/lecturas/registrar/{ServicioId:int}"
@attribute [Authorize(Roles = "Administrador,Operador")]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Asada.Aplicacion.Common

@inject ObtenerLecturasPeriodoCasoUso ObtenerLecturas
@inject RegistrarLecturaCasoUso RegistrarLecturaUso
@inject IProveedorFecha Fecha
@inject NavigationManager Navegacion

<PageTitle>Registrar lectura</PageTitle>

<p><a href="lecturas?anio=@(anioQuery)&mes=@(mesQuery)">&larr; Volver a lecturas del periodo</a></p>

@if (cargado && fila is null)
{
    <div class="alert alert-warning">El servicio no existe, esta inactivo o no corresponde a este periodo.</div>
    return;
}

@if (Modelo is null || fila is null)
{
    <p><em>Cargando...</em></p>
    return;
}

<h1>Registrar lectura</h1>

<div class="card mb-3">
    <div class="card-body">
        <p class="mb-1"><strong>@fila.AbonadoCodigo</strong> &middot; @fila.AbonadoNombre</p>
        <p class="mb-1">@fila.PropiedadDireccion</p>
        <p class="mb-0 text-muted">Medidor: @(fila.NumeroSerieMedidor ?? "sin medidor activo")</p>
    </div>
</div>

@if (fila.NumeroSerieMedidor is null)
{
    <div class="alert alert-warning">
        Este servicio no tiene un medidor activo.
        <a href="servicios/@(ServicioId)/medidores">Instale un medidor</a> antes de registrar lecturas.
    </div>
    return;
}

<div class="row">
    <div class="col-lg-6">
        @* Sin <AntiforgeryToken />: el EditForm ya incluye el suyo. *@
        <EditForm Model="Modelo" method="post" OnValidSubmit="GuardarAsync" FormName="registrar-lectura">
            <DataAnnotationsValidator />

            @if (errores.Count > 0)
            {
                <div class="alert alert-danger" role="alert">
                    <ul class="mb-0">@foreach (var e in errores) { <li>@e</li> }</ul>
                </div>
            }

            <div class="row">
                <div class="col-md-7 mb-3">
                    <label for="mes" class="form-label">Periodo (mes)</label>
                    <InputSelect id="mes" class="form-select" @bind-Value="Modelo.Mes">
                        @for (var m = 1; m <= 12; m++)
                        {
                            <option value="@m">@Etiquetas.Mes(m)</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-5 mb-3">
                    <label for="anio" class="form-label">Anio</label>
                    <InputNumber id="anio" class="form-control" @bind-Value="Modelo.Anio" />
                </div>
            </div>

            <div class="mb-3">
                <label for="fecha" class="form-label">Fecha en que se tomo la lectura</label>
                <InputDate id="fecha" class="form-control" @bind-Value="Modelo.FechaLectura" />
                <div class="form-text">
                    Si la fecha cae fuera de la ultima semana del mes del periodo, la lectura se guarda pero queda marcada para revision.
                </div>
            </div>

            <div class="mb-3">
                <label for="lectura" class="form-label">Lectura del medidor (m³)</label>
                <InputNumber id="lectura" class="form-control" @bind-Value="Modelo.Lectura" />
            </div>

            <div class="mb-3">
                <label for="obs" class="form-label">Observaciones</label>
                <InputText id="obs" class="form-control" @bind-Value="Modelo.Observaciones" />
            </div>

            <button type="submit" class="btn btn-primary">Guardar lectura</button>
            <a class="btn btn-link" href="lecturas?anio=@(anioQuery)&mes=@(mesQuery)">Cancelar</a>
        </EditForm>
    </div>
</div>

@code {
    [Parameter] public int ServicioId { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "anio")] public int? AnioQuery { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "mes")] public int? MesQuery { get; set; }

    private FilaLecturaPeriodoDto? fila;
    private bool cargado;
    private int anioQuery;
    private int mesQuery;
    private List<string> errores = [];

    [SupplyParameterFromForm(FormName = "registrar-lectura")]
    private ModeloLectura? Modelo { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var periodo = AnioQuery is int a && MesQuery is int m && ReglasPeriodo.EsMesValido(a, m)
            ? (Anio: a, Mes: m)
            : ReglasPeriodo.PeriodoPorDefecto(Fecha.Hoy);

        anioQuery = periodo.Anio;
        mesQuery = periodo.Mes;

        var resultado = await ObtenerLecturas.EjecutarAsync(anioQuery, mesQuery);
        fila = resultado.Valor?.Filas.FirstOrDefault(f => f.ServicioId == ServicioId);
        cargado = true;
        if (fila is null) return;

        // Si la pagina llega por un envio del formulario, Modelo ya trae lo que escribio el usuario.
        Modelo ??= new ModeloLectura
        {
            Anio = periodo.Anio,
            Mes = periodo.Mes,
            FechaLectura = Fecha.Hoy,
        };
    }

    private async Task GuardarAsync()
    {
        var resultado = await RegistrarLecturaUso.EjecutarAsync(new RegistrarLecturaSolicitud(
            ServicioId, Modelo!.Anio, Modelo.Mes, Modelo.FechaLectura, Modelo.Lectura ?? 0m, Modelo.Observaciones));

        if (resultado.EsExitoso)
        {
            var revision = resultado.Valor!.RequiereRevision ? "&revision=1" : "";
            Navegacion.NavigateTo($"/lecturas?anio={Modelo.Anio}&mes={Modelo.Mes}&ok=lectura{revision}", forceLoad: true);
            return;
        }
        errores = resultado.Errores.ToList();
    }

    private sealed class ModeloLectura
    {
        public int Anio { get; set; }
        public int Mes { get; set; }
        public DateOnly FechaLectura { get; set; }

        [Required(ErrorMessage = "Ingrese la lectura del medidor.")]
        public decimal? Lectura { get; set; }

        public string? Observaciones { get; set; }
    }
}
