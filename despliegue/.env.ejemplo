# Plantilla de despliegue/.env (Sprint 6a). instalar.sh crea el .env real a partir de las respuestas;
# tambien se puede copiar este archivo a .env y editarlo a mano:  cp .env.ejemplo .env && nano .env
# El .env tiene la contrasena de la base: nunca se sube a Git (esta en .gitignore) y queda con
# permisos 600 (solo lo lee el dueno).
#
# Despues de cambiar algo:  docker compose up -d

# --- Acceso al sistema (ver Caddyfile) ---
# Una IP (203.0.113.5), un nombre de sslip.io (203-0-113-5.sslip.io) o un dominio propio.
SITIO_DIRECCION=203-0-113-5.sslip.io
# "internal" (certificado propio, el navegador advierte) o un correo (certificado de Let's Encrypt;
# no funciona con una IP sola).
SITIO_TLS=internal

# --- Base de datos ---
# Solo letras y numeros (va dentro de la cadena de conexion). Generar con:  openssl rand -hex 24
# Solo se usa al crear la base por primera vez: cambiarla despues exige cambiarla tambien en PostgreSQL.
POSTGRES_CONTRASENA=cambiar_por_una_contrasena_larga

# --- Plataforma ---
# Correo con el que entra el Superadministrador. "docker compose run --rm app migrar" lo crea con una
# contrasena temporal que se muestra una sola vez.
SUPERADMIN_CORREO=superadmin@ejemplo.com

# --- Respaldos ---
# Carpeta del servidor donde quedan los respaldos (fuera de la carpeta del repositorio).
RUTA_RESPALDOS=/srv/asada/respaldos
RESPALDO_HORA=02:30
RESPALDO_DIARIOS=30
RESPALDO_SEMANALES=12

# Copias fuera del servidor con rclone: uno o varios destinos separados por espacios, con la forma
# REMOTO:CARPETA. Cada REMOTO se configura una vez con
#   docker compose run --rm --entrypoint rclone respaldo config
# (ver LEEME.md, "Respaldos fuera del servidor"). Ejemplos:
#   RESPALDO_DESTINOS=gdrive:RespaldosASADA
#   RESPALDO_DESTINOS=gdrive:RespaldosASADA onedrive:RespaldosASADA
#   RESPALDO_DESTINOS=gdrive:RespaldosASADA onedrive:RespaldosASADA b2:asada-respaldos
# Vacio = los respaldos solo quedan en el servidor (y en la PC que los descargue a mano).
RESPALDO_DESTINOS=
# Cuantos dias se conservan en los destinos (por defecto, los mismos que en el servidor:
# RESPALDO_DIARIOS dias para los diarios y RESPALDO_SEMANALES semanas para los semanales).
# RESPALDO_REMOTO_DIAS_DIARIOS=30
# RESPALDO_REMOTO_DIAS_SEMANALES=84
