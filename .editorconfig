root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.cs]
csharp_new_line_before_open_brace = all
csharp_indent_case_contents = true
dotnet_sort_system_directives_first = true

# Nombres: PascalCase para tipos y miembros públicos
dotnet_naming_rule.tipos_pascal_case.severity = suggestion
dotnet_naming_rule.tipos_pascal_case.symbols = tipos
dotnet_naming_rule.tipos_pascal_case.style = pascal_case
dotnet_naming_symbols.tipos.applicable_kinds = class, interface, struct, enum
dotnet_naming_style.pascal_case.capitalization = pascal_case

[*.{razor,razor.cs}]
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2
